{
  "name": "hzaconnect",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone support chat system for casino websites",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @hzaconnect/api db:migrate",
    "db:generate": "pnpm --filter @hzaconnect/api db:generate",
    "bootstrap": "bash scripts/bootstrap.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.13.0",
    "@types/node": "^22.8.0"
  }
}
