# --- License server (vendor side, NOT the casino) ---
NODE_ENV=production

PORT=4400
HOST=0.0.0.0
DB_PATH=./data/license-server.db

# Admin UI credentials. Pick a long random password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-random-string

# Cookie secret for the (future) admin session — currently unused but reserved.
COOKIE_SECRET=change-me-long-random-string

# Path to the Ed25519 keypair the server uses to sign license tokens.
# Generate with: pnpm --filter @hzaconnect/license-server keys:generate
LICENSE_PRIVATE_KEY_PATH=/etc/hzaconnect/private.pem
LICENSE_PUBLIC_KEY_PATH=/etc/hzaconnect/public.pem

# Default license duration when issuing a new one.
DEFAULT_LICENSE_DAYS=30
