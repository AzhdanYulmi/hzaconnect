# ---- hzaconnect deployment config ----
# Copy to .env and fill every value before `docker compose up -d`.

# Public origin served by nginx. Used by the widget loader and dashboard.
PUBLIC_ORIGIN=https://chat.example.com

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hzaconnect
POSTGRES_USER=hzaconnect
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://hzaconnect:change-me-strong-password@postgres:5432/hzaconnect

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible object storage for image attachments) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=hzaconnect-attachments
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=https://chat.example.com/s3

# --- Secrets (generate with: openssl rand -base64 48) ---
AUTH_JWT_SECRET=change-me-auth-jwt-secret-min-32-bytes
WIDGET_JWT_SECRET=change-me-widget-jwt-secret-min-32-bytes

# --- Bootstrap admin (consumed once by scripts/bootstrap.sh) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# --- API runtime ---
API_PORT=3000
API_HOST=0.0.0.0
API_LOG_LEVEL=info
# Comma-separated origins allowed to embed the widget. Use * only in dev.
WIDGET_ALLOWED_ORIGINS=*
# Cookie domain for refresh cookies (leave blank for same-origin).
COOKIE_DOMAIN=

NODE_ENV=production

# --- Licensing ---
# LICENSE_ENFORCEMENT must be "enabled" in production. The casino's API will
# refuse all business requests until the license verifies and the heartbeat
# succeeds.
LICENSE_ENFORCEMENT=enabled
# Issued by the vendor's license server (your side). Hand to the casino.
LICENSE_TOKEN=
# PEM-formatted Ed25519 public key matching the private key on your license server.
LICENSE_PUBLIC_KEY_PEM=
# Where the casino's API phones home for renewal/suspension state.
LICENSE_SERVER_URL=https://licenses.your-domain.example
# How often (seconds) to check in. 30 minutes is sane for a 30-day license.
LICENSE_HEARTBEAT_SECONDS=1800
# How long a heartbeat outage is tolerated before hard-blocking (seconds).
LICENSE_HEARTBEAT_GRACE_SECONDS=86400

