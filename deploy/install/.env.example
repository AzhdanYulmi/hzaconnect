# hzaconnect deploy bundle — generated by install.sh.
# You normally do not edit this by hand; re-run `hzaconnect install` or `hzaconnect doctor`.

# ---- Customer-facing ----
# Public hostname where this deployment will be reached. Must resolve to this server.
DOMAIN=chat.example.com
PUBLIC_ORIGIN=https://chat.example.com
# Email for Let's Encrypt registration. Used only for cert-expiry notices.
ACME_EMAIL=ops@example.com

# ---- Licensing (from your vendor) ----
LICENSE_TOKEN=
LICENSE_SERVER_URL=https://144-91-84-61.nip.io
LICENSE_HEARTBEAT_SECONDS=1800
LICENSE_HEARTBEAT_GRACE_SECONDS=86400

# ---- Bootstrap admin (created on first boot) ----
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# ---- Auto-generated secrets (do not edit) ----
POSTGRES_DB=hzaconnect
POSTGRES_USER=hzaconnect
POSTGRES_PASSWORD=
S3_REGION=us-east-1
S3_BUCKET=hzaconnect-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
AUTH_JWT_SECRET=
WIDGET_JWT_SECRET=

# ---- Optional tuning ----
API_LOG_LEVEL=info
WIDGET_ALLOWED_ORIGINS=*
COOKIE_DOMAIN=

# ---- Image source ----
# Override only if you mirror images to your own registry.
HZA_REGISTRY=ghcr.io/AzhdanYulmi
HZA_VERSION=latest
